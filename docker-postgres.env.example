# Copy to docker-postgres.env (gitignored) and edit, or export variables before `docker compose up`:
#   cp docker-postgres.env.example docker-postgres.env
#
# Docker Compose reads this file automatically if named `.env` in this folder — or pass explicitly:
#   docker compose --env-file docker-postgres.env up -d

POSTGRES_USER=restaurant_admin
POSTGRES_PASSWORD=restaurant_admin_dev
POSTGRES_DB=restaurant_admin
POSTGRES_PORT=5432
